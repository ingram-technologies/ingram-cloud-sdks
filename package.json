{
	"name": "@ingram-cloud/sdks",
	"version": "0.0.0",
	"private": true,
	"description": "The client libraries for Ingram Cloud: the wire contract and management client, and the Vercel AI SDK, eve, Flue and Pulumi integrations.",
	"homepage": "https://github.com/ingram-technologies/ingram-cloud-sdks#readme",
	"bugs": "https://github.com/ingram-technologies/ingram-cloud-sdks/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/ingram-cloud-sdks.git"
	},
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "bun run --filter '*' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14"
}
